# URL base del backend FastAPI (Docker Compose)
VITE_API_BASE_URL=http://localhost:8000

# NO hay VITE_COMMUNITY_TOKEN ni VITE_ADMIN_TOKEN en este proyecto.
# Los tokens se ingresan en runtime:
#   - X-Community-Token: campo password en /enviar-proyecto (solo memoria de la pestana).
#   - X-Admin-Token: campo password en /admin (solo memoria de la pestana).
# Nunca deben persistirse en el bundle ni en localStorage/sessionStorage.